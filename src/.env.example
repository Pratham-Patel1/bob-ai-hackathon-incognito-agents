# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ─── Database (async URL required for asyncpg) ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://supplychainOS:password@localhost:5432/supplychainOS

# ─── Application ──────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# ─── CORS (comma-separated for multiple origins) ──────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Business rules (tunable without code changes) ───────────────────────────
APPROVAL_THRESHOLD_USD=50000
SLA_BUFFER_HOURS=4
DAILY_HOLDING_COST_RATE=0.002
DEFAULT_SLA_PENALTY_USD=5000

# ─── ML ───────────────────────────────────────────────────────────────────────
ML_MODEL_PATH=../ml/artifacts/risk_model.joblib
ML_DETERMINISTIC_WEIGHT=0.6
ML_PREDICTIVE_WEIGHT=0.4

# ─── IBM watsonx.ai (Phase 2) ─────────────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─── Notifications (Phase 2) ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
